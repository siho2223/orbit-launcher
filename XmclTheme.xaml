<ResourceDictionary x:Class="OrbitLauncher.XmclTheme" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:OrbitLauncher">
 <local:InstanceSelectionConverter x:Key="XmclSelected"/><local:VersionVisualConverter x:Key="VersionVisual"/>
 <ItemsPanelTemplate x:Key="XmclGrid"><UniformGrid Columns="2"/></ItemsPanelTemplate>
 <ItemsPanelTemplate x:Key="OrbitWrap"><WrapPanel/></ItemsPanelTemplate>
 <Style x:Key="XmclNav" TargetType="Button" BasedOn="{StaticResource Nav}"><Setter Property="Width" Value="56"/><Setter Property="Height" Value="48"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,3"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid><Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Border x:Name="ActiveRail" Width="3" Height="20" Background="{DynamicResource Brush00E5A0}" HorizontalAlignment="Left" CornerRadius="2" Opacity="0"/><Border x:Name="HoverStroke" Background="#16FFFFFF" CornerRadius="8" Opacity="0" IsHitTestVisible="False"/></Grid><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Brush00E5A0}"/><Setter TargetName="B" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <DataTemplate x:Key="XmclInstanceCard"><Grid Height="86" Margin="0,0,12,10"><Button Style="{StaticResource CardButton}" Click="VersionCard_Click" Tag="{Binding}" Padding="0" HorizontalContentAlignment="Stretch"><Border Background="{Binding TileColor}" BorderBrush="#18FFFFFF" BorderThickness="1" CornerRadius="8" Padding="14,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><Border Background="#1859A765" CornerRadius="8" Width="38" Height="38"><Image Source="{Binding Converter={StaticResource VersionVisual},ConverterParameter=Icon}" Width="30" Height="30" RenderOptions.BitmapScalingMode="NearestNeighbor"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,8,0"><TextBlock Text="{Binding Title}" Foreground="{Binding TileForeground}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/><TextBlock Text="{Binding Subtitle}" Foreground="{Binding TileForeground}" FontSize="11" Margin="0,7,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Grid></Border></Button><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,9,7"><Button ToolTip="{DynamicResource L1}" Click="InstanceFolder_Click" Tag="{Binding}" Background="Transparent" Padding="5" Margin="0,0,4,0"><Viewbox Width="13" Height="12"><Path Data="M1,4 L1,2 L8,2 L10,4 L19,4 L19,16 L1,16 Z" Stroke="#ADB8AE" StrokeThickness="1.5"/></Viewbox></Button><Button ToolTip="{DynamicResource ExportTip}" Click="ExportPack_Click" Tag="{Binding}" Background="Transparent" Padding="5"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE898;" FontSize="12"/></Button></StackPanel><Border IsHitTestVisible="False" CornerRadius="8" BorderThickness="1.5" BorderBrush="{DynamicResource Brush00E5A0}"><Border.Visibility><MultiBinding Converter="{StaticResource XmclSelected}"><Binding/><Binding Path="CurrentInstance" RelativeSource="{RelativeSource AncestorType=Window}"/></MultiBinding></Border.Visibility></Border></Grid></DataTemplate>
 <DataTemplate x:Key="XmclRailItem"><Grid Width="108" Margin="0,4"><Button Tag="{Binding}" Click="XmclInstance_Click" Padding="5,7" Background="{Binding TileColor}" Foreground="{Binding TileForeground}" ToolTip="{Binding Title}" HorizontalContentAlignment="Stretch"><StackPanel><Image Source="{Binding Converter={StaticResource VersionVisual},ConverterParameter=Icon}" Width="28" Height="28" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/><TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" MaxHeight="30" Margin="0,4,0,0"/><TextBlock Text="{Binding RailLabel}" FontSize="9" TextTrimming="CharacterEllipsis" TextAlignment="Center" Margin="0,3,0,0"/></StackPanel></Button><Border IsHitTestVisible="False" BorderThickness="2" BorderBrush="#FFFFFF" CornerRadius="5"><Border.Visibility><MultiBinding Converter="{StaticResource XmclSelected}"><Binding/><Binding Path="CurrentInstance" RelativeSource="{RelativeSource AncestorType=Window}"/></MultiBinding></Border.Visibility></Border></Grid></DataTemplate>
</ResourceDictionary>